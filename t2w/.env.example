# Server-only values; never prefix these with NEXT_PUBLIC_.
DATABASE_URL=
# 32 bytes encoded as 64 hex characters. To import a COPY of existing Next.js
# data, use the hex encoding of its encryption.key; never commit that key.
ORGANIZATION_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-NEW-VERCEL-DOMAIN/api/auth/google/callback
